{
  "name": "eggd_cgp-purple",
  "title": "eggd_cgp-purple",
  "summary": "PURPLE 4.4-beta.12 tumour-only purity/ploidy/CN with optional max-ploidy cap and scalar outputs",
  "version": "1.0.0",
  "dxapi": "1.0.0",
  "developers": ["org-emee_1"],
  "authorizedUsers": ["org-emee_1"],
  "inputSpec": [
    {"name": "sample_id",        "class": "string", "label": "Sample ID"},
    {"name": "purple_jar",       "class": "file",   "label": "PURPLE JAR"},
    {"name": "amber_tar",        "class": "file",   "label": "AMBER output tar (.amber.tar.gz)"},
    {"name": "cobalt_tar",       "class": "file",   "label": "COBALT output tar (.cobalt.tar.gz)"},
    {"name": "gc_profile",       "class": "file",   "label": "GC_profile.1000bp.38.cnp (chr)"},
    {"name": "target_regions_bed","class": "file",  "label": "backbone_padded_150bp_nochr.bed"},
    {"name": "ref_fasta",        "class": "file",   "label": "Reference FASTA no-chr (.fasta.gz)"},
    {"name": "ref_fai",          "class": "file",   "label": "Reference FASTA index (.fasta.gz.fai)"},
    {"name": "ensembl_data",     "class": "file",   "label": "ensembl_data.tar.gz"},
    {"name": "somatic_vcf",      "class": "file",   "label": "SAGE somatic VCF (.vcf.gz) — improves purity anchoring", "optional": true},
    {"name": "somatic_vcf_tbi",  "class": "file",   "label": "SAGE somatic VCF index (.tbi)", "optional": true},
    {"name": "max_ploidy",       "class": "int",    "optional": true,
     "label": "Hard cap passed as PURPLE -max_ploidy. Mutually exclusive with ploidy_cap_purity_threshold."},
    {"name": "ploidy_cap_purity_threshold", "class": "float", "optional": true,
     "label": "If set, PURPLE runs unbounded first; if fitted purity < this, PURPLE re-runs with -max_ploidy ploidy_cap_value."},
    {"name": "ploidy_cap_value", "class": "int", "default": 2, "optional": true,
     "label": "The -max_ploidy value applied when the purity threshold triggers."}
  ],
  "outputSpec": [
    {"name": "purple_tar",       "class": "file",   "label": "PURPLE output directory (.purple.tar.gz)"},
    {"name": "purity_tsv",       "class": "file",   "label": "*.purple.purity.tsv — purity/ploidy summary"},
    {"name": "purity_range_tsv", "class": "file",   "label": "*.purple.purity.range.tsv — purity landscape"},
    {"name": "plots_tar",        "class": "file",   "label": "PURPLE chart PNGs (.tar.gz)", "optional": true},
    {"name": "cnv_somatic_tsv",  "class": "file",   "label": "*.purple.cnv.somatic.tsv (segment-level CN calls)", "patterns": ["*.purple.cnv.somatic.tsv"]},
    {"name": "cnv_gene_tsv",     "class": "file",   "label": "*.purple.cnv.gene.tsv (gene-level CN calls)", "patterns": ["*.purple.cnv.gene.tsv"]},
    {"name": "purity",           "class": "float",  "label": "Fitted purity (final pass)"},
    {"name": "ploidy",           "class": "int",    "label": "round(ploidy), min 1 (final pass)"},
    {"name": "sample_sex",       "class": "string", "label": "gender lowercased (male/female/unknown)"}
  ],
  "runSpec": {
    "interpreter": "bash",
    "file": "src/code.sh",
    "distribution": "Ubuntu",
    "release": "24.04",
    "version": "0",
    "timeoutPolicy": {"*": {"hours": 6}},
    "execDepends": [
      {"name": "openjdk-21-jre-headless", "package_manager": "apt"},
      {"name": "samtools",                "package_manager": "apt"},
      {"name": "tabix",                   "package_manager": "apt"},
      {"name": "jq",                      "package_manager": "apt"},
      {"name": "r-base",                  "package_manager": "apt"},
      {"name": "r-cran-ggplot2",          "package_manager": "apt"},
      {"name": "r-cran-tidyr",            "package_manager": "apt"},
      {"name": "r-cran-dplyr",            "package_manager": "apt"},
      {"name": "r-cran-cowplot",          "package_manager": "apt"},
      {"name": "circos",                  "package_manager": "apt"},
      {"name": "fonts-circos-symbols",    "package_manager": "apt"},
      {"name": "fonts-cmu",               "package_manager": "apt"}
    ],
    "systemRequirements": {
      "*": {"instanceType": "mem2_ssd1_v2_x4"}
    }
  },
  "regionalOptions": {"aws:eu-central-1": {}}
}
