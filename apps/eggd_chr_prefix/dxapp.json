{
  "name": "eggd_chr_prefix",
  "title": "eggd_chr_prefix",
  "summary": "Add the chr prefix to a BAM header (single-file, per-sample; passthrough if already prefixed)",
  "version": "1.0.0",
  "dxapi": "1.0.0",
  "developers": ["org-emee_1"],
  "authorizedUsers": ["org-emee_1"],
  "inputSpec": [
    {"name": "input_bam", "class": "file",   "label": "Raw tumour BAM (Ensembl or already-chr)", "patterns": ["*.bam"]},
    {"name": "mode",      "class": "string", "label": "Fixed to add_chr", "default": "add_chr", "optional": true}
  ],
  "outputSpec": [
    {"name": "output_bam", "class": "file", "label": "chr-prefixed (or passthrough) BAM", "patterns": ["*.bam"]},
    {"name": "output_bai", "class": "file", "label": "Generated index", "patterns": ["*.bai"]}
  ],
  "runSpec": {
    "interpreter": "bash",
    "file": "src/code.sh",
    "distribution": "Ubuntu",
    "release": "24.04",
    "version": "0",
    "timeoutPolicy": {"*": {"hours": 2}},
    "execDepends": [
      {"name": "samtools", "package_manager": "apt"}
    ],
    "systemRequirements": {
      "*": {"instanceType": "mem1_ssd1_v2_x2"}
    }
  },
  "regionalOptions": {"aws:eu-central-1": {}}
}
